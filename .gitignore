# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Editor state — one person's theme is not project configuration
.vscode/
.idea/

# Live mirror storage (multi-TB) — never track
mirror/

# Machine-local state
.pytest_cache/
.ruff_cache/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Profiler output (machine-local, appended to by running syncs)
mmw-profile-*.txt

# Live machine-local config — per working directory, never shared
mmw.toml

# pytest-textual-snapshot report (regenerated on every snapshot run)
snapshot_report.html
